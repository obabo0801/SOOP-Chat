{
  "name": "soop-chat",
  "version": "1.1.0",
  "license": "MIT",
  "author": "unjongjjing",
  "type": "module",
  "main": "src/soop/index.js",
  "exports": {
    ".": "./src/soop/index.js",
    "./soop/*": "./src/soop/*.js"
  },
  "scripts": {
    "start": "node --no-maglev src/soop/editor/runtime.js index",
    "start:multi": "node --no-maglev src/soop/editor/runtime.js multi",
    "stop:multi": "node src/multi.js --stop"
  },
  "imports": {
    "#soop/*": "./src/soop/*.js",
    "#utils/*": "./src/utils/*.js"
  },
  "files": [
    "src/multi.js",
    "src/soop",
    "src/utils",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "dotenv": "^17.4.2",
    "hls.js": "^1.7.3",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  }
}
