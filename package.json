{
  "name": "soop-chat",
  "version": "1.0.5",
  "license": "MIT",
  "author": "unjongjjing",
  "type": "module",
  "main": "src/soop/index.js",
  "exports": {
    ".": "./src/soop/index.js",
    "./soop/*": "./src/soop/*.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:multi": "node src/multi.js",
    "stop:multi": "node src/multi.js --stop"
  },
  "imports": {
    "#soop/*": "./src/soop/*.js",
    "#utils/*": "./src/utils/*.js"
  },
  "files": [
    "src/soop",
    "src/utils",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "dotenv": "^17.4.2",
    "https-proxy-agent": "^9.1.0",
    "playwright": "^1.62.1",
    "undici": "^7.30.0",
    "ws": "^8.21.0"
  }
}
